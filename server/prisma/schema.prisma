// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password        String
  bio             String   @default("Hi! I am a user on this blog.")
  profile_picture String?
  roles           String[] @default(["commenter"])
  created_date    DateTime @default(now())

  user_posts    Post[]
  user_comments Comment[]
}

model Post {
  id                Int       @id @default(autoincrement())
  user_id           Int?
  title             String    @db.VarChar(255)
  content           String
  is_public         Boolean   @default(false)
  published_date    DateTime?
  last_updated_date DateTime  @default(now())

  post_user     User?     @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  post_comments Comment[]
}

model Comment {
  id                Int      @id @default(autoincrement())
  user_id           Int?
  post_id           Int
  content           String
  likes             Int      @default(0)
  parent_comment_id Int?
  created_date      DateTime @default(now())

  comment_user   User?     @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  comment_post   Post      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent_comment Comment?  @relation("ParentChildrenComment", fields: [parent_comment_id], references: [id])
  child_comment  Comment[] @relation("ParentChildrenComment")
}
